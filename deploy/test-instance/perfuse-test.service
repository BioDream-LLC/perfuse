[Unit]
Description=Perfuse public test instance (test data only)
After=network-online.target
Wants=network-online.target

[Service]
User=perfuse
Group=perfuse
WorkingDirectory=/opt/perfuse
ExecStart=/opt/perfuse/perfuse serve -db /opt/perfuse/data/perfuse.db -channels /opt/perfuse/channels \
  -addr :443 -tls-cert /opt/perfuse/tls/fullchain.pem -tls-key /opt/perfuse/tls/privkey.pem \
  -public-url https://test.perfuse.health -fleet-label "Perfuse public test" \
  -fhir -pas -fhir-subscriptions -fhir-bulk-export -fhir-payer-apis \
  -crd-rules /opt/perfuse/conf/rules.yaml -cds-clients /opt/perfuse/conf/cds-clients.yaml \
  -smart-clients /opt/perfuse/conf/clients.yaml -smart-users /opt/perfuse/conf/users.yaml \
  -smart-key /opt/perfuse/data/smart-signing.key
Restart=on-failure
RestartSec=5
TimeoutStopSec=90
KillSignal=SIGTERM
# Port 443 without root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/perfuse/data /opt/perfuse/channels /opt/perfuse/logs
StandardOutput=append:/opt/perfuse/logs/perfuse.log
StandardError=append:/opt/perfuse/logs/perfuse.log

[Install]
WantedBy=multi-user.target
