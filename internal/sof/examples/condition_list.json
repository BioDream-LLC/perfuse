{
  "resourceType": "ViewDefinition",
  "name": "condition_list",
  "title": "Conditions",
  "status": "active",
  "resource": "Condition",
  "select": [
    {
      "column": [
        { "name": "id", "path": "getResourceKey()", "type": "id" },
        { "name": "patient_id", "path": "subject.getReferenceKey(Patient)", "type": "id" },
        { "name": "clinical_status", "path": "clinicalStatus.coding.code.first()", "type": "code" },
        { "name": "onset", "path": "onset.ofType(dateTime)", "type": "dateTime" },
        { "name": "recorded", "path": "recordedDate", "type": "dateTime" }
      ]
    },
    {
      "forEachOrNull": "code.coding.first()",
      "column": [
        { "name": "system", "path": "system", "type": "uri" },
        { "name": "code", "path": "code", "type": "code" },
        { "name": "display", "path": "display", "type": "string" }
      ]
    }
  ]
}
