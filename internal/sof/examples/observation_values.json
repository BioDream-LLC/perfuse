{
  "resourceType": "ViewDefinition",
  "name": "observation_values",
  "title": "Observations with a number",
  "status": "active",
  "resource": "Observation",
  "where": [{ "path": "value.ofType(Quantity).exists()" }],
  "select": [
    {
      "column": [
        { "name": "id", "path": "getResourceKey()", "type": "id" },
        { "name": "patient_id", "path": "subject.getReferenceKey(Patient)", "type": "id" },
        { "name": "status", "path": "status", "type": "code" },
        { "name": "effective", "path": "effective.ofType(dateTime)", "type": "dateTime" },
        { "name": "value", "path": "value.ofType(Quantity).value", "type": "decimal" },
        { "name": "unit", "path": "value.ofType(Quantity).code", "type": "code" }
      ]
    },
    {
      "forEach": "code.coding",
      "column": [
        { "name": "system", "path": "system", "type": "uri" },
        { "name": "code", "path": "code", "type": "code" },
        { "name": "display", "path": "display", "type": "string" }
      ]
    }
  ]
}
